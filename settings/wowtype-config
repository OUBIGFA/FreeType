# 地址、大小、MD5 和 voice/src/wtlocal/pack.rs 一致（那边有测试对这三个值）
VOICE_MODEL_URL = os.environ.get("WOWTYPE_VOICE_MODEL_URL") or "https://download.z.weixin.qq.com/publish_words/v1/ime_asr_decoder_model/20260710220526250_ime_asr_decoder_model.apk"  # noqa: E501
VOICE_MODEL_SIZE = 102920639
VOICE_MODEL_MD5 = "28386481eb94ff73b28ee3949c0cf690"
# 测试用：换成本机的假服务和假包
if os.environ.get("WOWTYPE_VOICE_MODEL_MD5"):
    VOICE_MODEL_MD5 = os.environ["WOWTYPE_VOICE_MODEL_MD5"]
