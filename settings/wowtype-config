def unpack_llama(archive, root):
    """把官方包解到 root（先解到 root.new，能跑了再换上去）。只要 llama-server 和它的动态库。

    包里的路径、链接都查一遍，不往目录外面写。llama-server 跑不起来（缺系统库、glibc 太旧）时
    抛 ValueError，带上它报的错。"""
    import tarfile
    fresh = root + ".new"
    shutil.rmtree(fresh, ignore_errors=True)
    os.makedirs(fresh)
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar:
                name = os.path.basename(member.name)
                parts = member.name.split("/")
                if ".." in parts or member.name.startswith("/") or len(parts) != 2:
                    continue  # 只要顶层目录下的文件
                wanted = name == "llama-server" or (name.startswith("lib") and ".so" in name)
                if not wanted:
                    continue
                target = os.path.join(fresh, name)
                if member.issym():
                    if "/" in member.linkname or member.linkname in ("", ".", ".."):
                        raise ValueError(f"包里的链接不对：{member.name}")
                    os.symlink(member.linkname, target)
                elif member.isfile():
                    with tar.extractfile(member) as src, open(target, "wb") as out:
                        shutil.copyfileobj(src, out)
                    os.chmod(target, 0o755)
        server = os.path.join(fresh, "llama-server")
        if not os.path.isfile(server):
            raise ValueError("包里没有 llama-server")
        try:
            run = subprocess.run([server, "--version"], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise ValueError(f"llama-server 跑不起来：{e}") from e
        if run.returncode != 0:
            lines = (run.stderr or run.stdout).strip().splitlines()
            raise ValueError("llama-server 跑不起来：" + (lines[-1] if lines else f"退出码 {run.returncode}"))
        with open(os.path.join(fresh, "VERSION"), "w", encoding="utf-8") as f:
            f.write(LLAMA_BUILD + "\n")
        shutil.rmtree(root, ignore_errors=True)
        os.replace(fresh, root)
    except (tarfile.TarError, EOFError) as e:
        raise ValueError(f"包解不开：{e}") from e
    finally:
        shutil.rmtree(fresh, ignore_errors=True)
    return os.path.join(root, "llama-server")


