    def on_translate_toggled(self, row, _param):
        self.refresh_translate_status()
        if row.get_active() and self.translate_ready():
            self.toast("单按 Shift 两下切到「译」")

    def translate_ready(self):
        if self.values.get("TranslateLocal") == "True":
            return self.local_ready()
        return bool(self.url_row.get_text().strip() and self.tmodel_row.get_text().strip())

    def refresh_translate_status(self):
        if not hasattr(self, "test_row"):
            return
        conflicts = getattr(self, "shift_conflicts", [])
        toggle = self.values.get("ShiftToggle", "Both")
        usable = [SHIFT_NAMES[s] for s in SHIFT_SIDES.get(toggle, ())
                  if s not in {bare_shift(k) for _o, k in conflicts}]
        if not self.translate_ready():
            self.translate_row.set_subtitle(
                "先在下面下载翻译模型，Shift 才切得到「译」"
                if self.values.get("TranslateLocal") == "True"
                else "先填好下面的翻译服务，Shift 才切得到「译」")
        elif toggle == "Off":
            self.translate_row.set_subtitle("「输入」页里关掉了 Shift 切换，切不到「译」")
        elif conflicts:
            taken = shift_side_names(conflicts)
            self.translate_row.set_subtitle(
                f"{taken} 被 fcitx5 占着；" + (f"用{'、'.join(usable)}，" if usable else "")
                + "或到「输入」页把它让给 WowType")
        else:
            self.translate_row.set_subtitle("单按 Shift：中 → 英 → 译 → 中")

    def on_test_translate(self, _button):
        base = self.url_row.get_text().strip()
        model = self.tmodel_row.get_text().strip()
        key = self.key_entry.get_text().strip()
        if not base or not model:
            self.test_row.set_subtitle("先填接口地址和模型")
            return
        target = self.target_codes[self.target_row.get_selected()]
        self.test_button.set_sensitive(False)
        self.test_row.set_subtitle("正在连接…")

        def work():
            try:
                text, seconds = test_translate(base, key, model, target)
                result = (text, seconds, None)
            except TranslateError as e:
                result = (None, 0, str(e))
            GLib.idle_add(self.test_finished, *result)
        threading.Thread(target=work, daemon=True).start()

    def test_finished(self, text, seconds, error):
        self.test_button.set_sensitive(True)
        if error:
            self.test_row.set_subtitle(GLib.markup_escape_text(f"✗ {error}"))
            log(f"测试翻译服务失败：{error}")
            return
        message = f"✓ 你好 → {text}（{seconds:.1f} 秒）"
        if seconds > 2.5:
            message += "。有点慢，打字时得等一会儿，可以换个小一点的模型"
        self.test_row.set_subtitle(GLib.markup_escape_text(message))
        log(f"测试翻译服务成功（{seconds:.1f} 秒）")

