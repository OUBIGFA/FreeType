def read_custom_words():
    words = []
    try:
        with open(CUSTOM_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip("\r\n")
                if not line.strip() or line.startswith("#"):
                    continue
                cols = line.split("\t")
                if len(cols) >= 2 and cols[1].strip():
                    words.append((cols[0].strip(), cols[1].strip()))
    except OSError:
        pass
    return words


def parse_custom_words(text):
    """自定义词文件的内容 -> [(编码, 词)]。编码是拼音（空格分音节）或 mail 这类字母编码。"""
    words = []
    for line in text.splitlines():
        line = line.rstrip("\r")
        if not line.strip() or line.startswith("#"):
            continue
        cols = line.split("\t")
        if len(cols) < 2 or not cols[1].strip():
            continue
        code = normalize_code(cols[0])
        if code is not None:
            words.append((code, cols[1].strip()))
    return words


def merge_custom_words(words, incoming):
    """把 incoming 合进 words：同一个词用新的编码，返回 (合并后的列表, 新增数, 更新数)。"""
    merged = list(words)
    added = updated = 0
    for code, word in incoming:
        old = [(c, w) for c, w in merged if w == word]
        if old == [(code, word)]:
            continue
        if old:
            updated += 1
        else:
            added += 1
        merged = [(c, w) for c, w in merged if w != word] + [(code, word)]
    return merged, added, updated


def write_custom_words(words, path=None):
    out = ["# WowType 自定义词：编码<TAB>词。编码是拼音（空格分开音节），也可以是 mail 这类字母；",
           "# 词里写 \\n 表示换行。由 WowType 设置维护，也可以手动编辑。"]
    out += [f"{pinyin}\t{word}" for pinyin, word in words]
    write_atomic(path or CUSTOM_FILE, "\n".join(out) + "\n")


# ---------------------------------------------------------------- 拼音


def split_syllables(text):
    """nihao -> ['ni', 'hao']：音节数最少，一样多时前面的取长的。切不开返回 None。"""
    n = len(text)
    best = [None] * (n + 1)
    best[n] = (0, 0)
    for i in range(n - 1, -1, -1):
        for length in range(min(6, n - i), 0, -1):
            if text[i:i + length] in SYLLABLES and best[i + length] is not None:
                count = best[i + length][0] + 1
                if best[i] is None or count < best[i][0]:
                    best[i] = (count, length)
    if best[0] is None:
        return None
    parts, i = [], 0
    while i < n:
        length = best[i][1]
        parts.append(text[i:i + length])
        i += length
    return parts


def normalize_code(text):
    """自定义词的编码：拼音整理成空格分隔的音节；不是拼音但全是字母的（mail）原样小写。
    都不是返回 None。"""
    pinyin = normalize_pinyin(text)
    if pinyin is not None:
        return pinyin
    code = text.strip().lower().replace("'", "")
    return code if code and code.isascii() and code.isalpha() else None


def normalize_pinyin(text):
    """把用户打的拼音整理成空格分隔的音节：Ni Hǎo / nihao / ni'hao -> ni hao。不合法返回 None。"""
    text = unicodedata.normalize("NFD", text.strip().lower())
    text = text.replace("u\u0308", "v").replace("u:", "v")
    # 去掉声调符号和数字声调
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = "".join(c for c in text if not c.isdigit())
    syllables = []
    for token in text.replace("'", " ").replace("’", " ").split():
        if token in SYLLABLES:
            syllables.append(token)
        elif token == "r" and syllables:
            syllables.append(token)  # 儿化
        else:
            parts = split_syllables(token)
            if parts is None:
                return None
            syllables += parts
    return " ".join(syllables) if syllables else None


class PinyinGuesser:
    """在词库里查词的拼音（后台载入，查词时在内存里找，几十毫秒）。"""

    def __init__(self):
        self.data = None
        threading.Thread(target=self._load, daemon=True).start()

    def _load(self):
        for path in LEXICON_CANDIDATES:
            if path and os.path.exists(path):
                try:
                    with open(path, "rb") as f:
                        self.data = f.read()
                    return
                except OSError:
                    continue

    def _lookup(self, word):
        data = self.data
        needle = b"\t" + word.encode("utf-8") + b"\t"
        best, best_freq = None, -1.0
        pos = data.find(needle)
        while pos >= 0:
            start = data.rfind(b"\n", 0, pos) + 1
            end = data.find(b"\n", pos)
            end = len(data) if end < 0 else end
            freq_text = data[pos + len(needle):end].strip()
            try:
                freq = float(freq_text)
            except ValueError:
                freq = 0.0
            if freq > best_freq:
                best, best_freq = data[start:pos].decode("utf-8", "replace"), freq
            pos = data.find(needle, end)
        return best

    def guess(self, word):
        """返回拼音，猜不出（有生僻字、英文、词库还没载入）返回 None。"""
        if not self.data or not word:
            return None
        found = self._lookup(word)
        if found:
            return normalize_pinyin(found)
        readings = []
        for char in word:
            reading = self._lookup(char)
            if not reading:
                return None
            readings.append(reading)
        return normalize_pinyin(" ".join(readings))


# ---------------------------------------------------------------- fcitx5


class Fcitx:
    NAME = "org.fcitx.Fcitx5"
    PATH = "/controller"
    IFACE = "org.fcitx.Fcitx.Controller1"

    def __init__(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            self.bus = None

    def call(self, method, params=None, reply=None, done=None):
        """异步调 fcitx5；done(结果或 None)。fcitx5 没在跑时 done(None)。"""
        if not self.bus:
            if done:
                done(None)
            return

        def finished(bus, result):
            try:
                value = bus.call_finish(result)
            except GLib.Error:
                value = None
            if done:
                done(value)

        self.bus.call(self.NAME, self.PATH, self.IFACE, method, params,
                      GLib.VariantType(reply) if reply else None,
                      Gio.DBusCallFlags.NO_AUTO_START, 2000, None, finished)

    def reload(self):
        self.call("ReloadAddonConfig", GLib.Variant("(s)", ("wowtype",)))

    def restart(self, done=None):
        if not kwin_input_method():
            self.call("Restart", done=lambda value: done and done(value is not None))
            return

        # KDE Wayland：D-Bus 的 Restart 不起作用，要经 KWin 重启；要等好几秒，放到线程里
        def work():
            ok = restart_fcitx_sync()
            if done:
                GLib.idle_add(lambda: done(ok) and False)
        threading.Thread(target=work, daemon=True).start()

    def group_info(self, done):
        """done((组名, 键盘布局, [(输入法, 布局)…]) 或 None)。"""
        def got_group(value):
            if value is None:
                done(None)
                return
            group = value.unpack()[0]
            self.call("InputMethodGroupInfo", GLib.Variant("(s)", (group,)), "(sa(ss))",
                      lambda info: done(None if info is None else (group, *info.unpack())))
        self.call("CurrentInputMethodGroup", None, "(s)", got_group)

    def get_config(self, uri, done):
        """done({键: 值字符串} 或 None)。"""
        self.call("GetConfig", GLib.Variant("(s)", (uri,)), "(va(sa(sssva{sv})))",
                  lambda value: done(None if value is None else value.unpack()[0]))

    def set_config(self, uri, values, done=None):
        """只改给出的几项（fcitx5 按部分配置合并），立即生效。"""
        raw = GLib.Variant("a{sv}", {k: GLib.Variant("s", v) for k, v in values.items()})
        self.call("SetConfig", GLib.Variant("(sv)", (uri, raw)),
                  done=lambda value: done and done(value is not None))

    def add_to_group(self, group, layout, items, done):
        items = list(items) + [("wowtype", "")]
        self.call("SetInputMethodGroupInfo", GLib.Variant("(ssa(ss))", (group, layout, items)),
                  done=lambda value: done(value is not None))

    def set_hotkeys(self, lists, done=None):
        """改 fcitx5 全局快捷键里的几个按键列表 {选项: [按键…]}，别的不动，立即生效。"""
        raw = GLib.Variant("a{sv}", {"Hotkey": GLib.Variant(
            "a{sv}", {option: key_list_variant(keys) for option, keys in lists.items()})})
        self.call("SetConfig", GLib.Variant("(sv)", (GLOBAL_URI, raw)),
                  done=lambda value: done and done(value is not None))


# ---------------------------------------------------------------- 和 fcitx5 抢 Shift
#
# fcitx5 默认把左 Shift 设成「临时切换输入法」（在当前输入法和排第一的键盘之间来回切），
# 它先拿到这一下，WowType 就收不到，单按左 Shift 切不了中英文和「译」。
# fcitx5 全局快捷键里每一项都是这样（instance.cpp 的 keyHandlers），所以几项都要看。

GLOBAL_URI = "fcitx://config/global"
FCITX_OPTION_NAMES = {
    "AltTriggerKeys": "临时切换输入法",
    "TriggerKeys": "切换输入法",
    "EnumerateForwardKeys": "向前切换输入法",
    "EnumerateBackwardKeys": "向后切换输入法",
    "EnumerateGroupForwardKeys": "切换到下一个分组",
    "EnumerateGroupBackwardKeys": "切换到上一个分组",
    "ActivateKeys": "激活输入法",
    "DeactivateKeys": "取消激活输入法",
}
FCITX_SHIFT_OPTIONS = tuple(FCITX_OPTION_NAMES)
# 配置文件里没写这一项时 fcitx5 用的默认值（globalconfig.cpp）
FCITX_HOTKEY_DEFAULTS = {
    "AltTriggerKeys": ["Shift_L"],
    "TriggerKeys": ["Control+space", "Zenkaku_Hankaku", "Hangul"],
    "EnumerateForwardKeys": [],
    "EnumerateBackwardKeys": [],
    "EnumerateGroupForwardKeys": ["Super+space"],
    "EnumerateGroupBackwardKeys": ["Super+Shift+space"],
    "ActivateKeys": ["Hangul_Hanja"],
    "DeactivateKeys": ["Hangul_Romaja"],
}
SHIFT_SIDES = {"Both": ("Shift_L", "Shift_R"), "Left": ("Shift_L",), "Right": ("Shift_R",),
               "Off": ()}
SHIFT_NAMES = {"Shift_L": "左 Shift", "Shift_R": "右 Shift"}


def key_list(value):
    """fcitx5 的按键列表（{"0": "Shift_L", …}；空列表读出来是空串）→ [按键…]。"""
    if not isinstance(value, dict):
        return []
    order = sorted(value, key=lambda k: int(k) if k.isdigit() else 1 << 30)
    return [value[k] for k in order if isinstance(value[k], str) and value[k]]


def key_list_variant(keys):
    return GLib.Variant("a{sv}", {str(i): GLib.Variant("s", k) for i, k in enumerate(keys)})


def bare_shift(key):
    """单按的那个 Shift（Shift_L、Shift+Shift_L 这种），不是就返回 None。"""
    *mods, name = key.split("+")
    if name in SHIFT_NAMES and all(m == "Shift" for m in mods):
        return name
    return None


def shift_conflicts(hotkey, toggle):
    """fcitx5 快捷键里占着 WowType 要用的 Shift 的：[(选项, 按键)…]。"""
    sides = SHIFT_SIDES.get(toggle, SHIFT_SIDES["Both"])
    found = []
    for option in FCITX_SHIFT_OPTIONS:
        for key in key_list((hotkey or {}).get(option)):
            if bare_shift(key) in sides:
                found.append((option, key))
    return found


def without_shift(hotkey, toggle):
    """去掉 WowType 要用的 Shift：返回要写回的 {选项: [按键…]} 和去掉了的 [(选项, 按键)…]。"""
    conflicts = shift_conflicts(hotkey, toggle)
    lists = {}
    for option, key in conflicts:
        lists.setdefault(option, key_list(hotkey.get(option))).remove(key)
    return lists, conflicts


def with_keys(hotkey, keys):
    """把让出去的按键 [(选项, 按键)…] 加回 fcitx5：返回要写回的 {选项: [按键…]}。"""
    lists = {}
    for option, key in keys:
        current = lists.setdefault(option, key_list((hotkey or {}).get(option)))
        if key not in current:
            current.append(key)
    return lists


def fcitx_config_files():
    """fcitx5 找全局配置 config 的顺序：用户目录（SKIP_FCITX_USER_PATH 时跳过），再 XDG_CONFIG_DIRS。"""
    files = []
    if os.environ.get("SKIP_FCITX_USER_PATH") not in ("1", "true", "True"):
        files.append(os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "fcitx5", "config"))
    dirs = os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg"
    files += [os.path.join(d, "fcitx5", "config") for d in dirs.split(":") if d]
    return files


def parse_fcitx_hotkey(text):
    """fcitx5 全局配置文件 → 和 GetConfig 一样的 Hotkey 字典（{选项: {"0": 按键…}}）。

    [Hotkey/选项] 下面的 0=、1=… 是列表；[Hotkey] 里写「选项=」（空）是空列表；
    都没写的用 fcitx5 的默认值。
    """
    sections = {}
    section = None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = sections.setdefault(line[1:-1], {})
            continue
        key, sep, value = line.partition("=")
        if sep and section is not None:
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] == '"':
                value = value[1:-1]
            section[key.strip()] = value
    hotkey = {}
    for option, default in FCITX_HOTKEY_DEFAULTS.items():
        if f"Hotkey/{option}" in sections:
            hotkey[option] = dict(sections[f"Hotkey/{option}"])
        elif option in sections.get("Hotkey", {}):
            hotkey[option] = ""
        else:
            hotkey[option] = {str(i): k for i, k in enumerate(default)}
    return hotkey


def saved_fcitx_hotkey():
    """fcitx5 下次启动时会用的全局快捷键：(Hotkey 字典, 读的文件或 None)。"""
    for path in fcitx_config_files():
        try:
            with open(path, encoding="utf-8") as f:
                return parse_fcitx_hotkey(f.read()), path
        except OSError:
            continue
    return parse_fcitx_hotkey(""), None


def fcitx_config_hint():
    """fcitx5 存不了全局配置时，说一下为什么、怎么办。"""
    user = os.path.join(_xdg("XDG_CONFIG_HOME", "~/.config"), "fcitx5")
    if os.environ.get("SKIP_FCITX_USER_PATH") in ("1", "true", "True"):
        why = "设了 SKIP_FCITX_USER_PATH，fcitx5 不读也不存用户配置"
    elif os.path.realpath(user).startswith("/nix/store/"):
        why = f"{user} 是 Home Manager 生成的只读目录"
    else:
        why = f"fcitx5 没能写进 {user}/config"
    return (f"{why}，重启 fcitx5 或重新登录后 Shift 又会被拿走。"
            "NixOS 请在 Nix 配置里写（见安装说明 NixOS 一节）")


def shift_side_names(conflicts):
    """[(选项, 按键)…] → 「左 Shift」「左右 Shift」这类说法。"""
    sides = {bare_shift(key) for _option, key in conflicts}
    if sides >= {"Shift_L", "Shift_R"}:
        return "左右 Shift"
    return "、".join(SHIFT_NAMES[s] for s in ("Shift_L", "Shift_R") if s in sides)


def key_label(key):
    """fcitx5 的按键名 → 给人看的（Control+space → Ctrl+空格）。"""
    names = {"Control": "Ctrl", "space": "空格", "Super": "Super", "Alt": "Alt"}
    return "+".join(names.get(part, part) for part in key.split("+"))



