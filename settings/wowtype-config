def lexicon_pack_version(folder=WANXIANG_DIR):
    """装好的词库包的版本，没装返回 None。"""
    if not os.path.isfile(os.path.join(folder, "lexicon.tsv")):
        return None
    try:
        with open(os.path.join(folder, "VERSION"), encoding="utf-8") as f:
            return f.read().strip() or "?"
    except OSError:
        return "?"


def find_lexicon_asset(release, pattern=WANXIANG_ASSET):
    """发布里的词库包：(文件名, 地址, 版本)，没有返回 None。有好几个时取版本最大的。"""
    found = []
    for name, url in (release or {}).get("assets", {}).items():
        match = pattern.fullmatch(name)
        if match:
            found.append((parse_version(match.group(1)), match.group(1), name, url))
    if not found:
        return None
    _key, version, name, url = max(found)
    return name, url, version


def install_lexicon_pack(tarball, folder=WANXIANG_DIR):
    """把词库包解到 folder（先解到旁边的临时目录，检查好了再换进去），返回版本。

    只认 LEXICON_PACK_FILES 里的普通文件，别的（目录、链接、../ 路径）一律不解。
    旧目录连同它的词库快照（lexicon.tsv.wcache）一起删掉，插件下次载入时重建快照。"""
    import tarfile
    parent = os.path.dirname(folder)
    os.makedirs(parent, exist_ok=True)
    staging = folder + ".new"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging)
    try:
        with tarfile.open(tarball, "r:gz") as tar:
            for member in tar.getmembers():
                name = member.name.removeprefix("./")
                if not name or name == ".":
                    continue
                if name not in LEXICON_PACK_FILES or not member.isfile():
                    raise ValueError(f"词库包里有不认识的文件 {member.name}，不安装")
                source = tar.extractfile(member)
                with source, open(os.path.join(staging, name), "wb") as out:
                    shutil.copyfileobj(source, out)
        lexicon = os.path.join(staging, "lexicon.tsv")
        if not os.path.isfile(lexicon):
            raise ValueError("词库包里没有 lexicon.tsv，不安装")
        count = 0
        with open(lexicon, encoding="utf-8") as f:
            for line in f:
                if line.startswith("#") or not line.strip():
                    continue
                if len(line.rstrip("\n").split("\t")) < 2:
                    raise ValueError("lexicon.tsv 格式不对（应为 拼音<TAB>词<TAB>频次），不安装")
                count += 1
        if count < LEXICON_PACK_MIN:
            raise ValueError(f"lexicon.tsv 只有 {count} 条，像是不完整，不安装")
        old = folder + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.exists(folder):
            os.replace(folder, old)
        os.replace(staging, folder)
        shutil.rmtree(old, ignore_errors=True)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise
    return lexicon_pack_version(folder)


def remove_lexicon_pack(folder=WANXIANG_DIR):
    """删掉词库包（和它的词库快照），返回空出的字节数。"""
    size = dir_size(folder) if os.path.isdir(folder) else 0
    shutil.rmtree(folder, ignore_errors=True)
    return size


def install_lexicon_cli(args):
    """命令行：--install-lexicon wanxiang|<文件.tar.gz> 下载/装上万象并切过去，--use-lexicon rime-ice 切回。"""
    values, extra = read_config()
    if args[0] == "--use-lexicon":
        if args[1:] != ["rime-ice"] and args[1:] != ["wanxiang"]:
            print("用法：wowtype-config --use-lexicon rime-ice|wanxiang")
            return 2
        if args[1] == "wanxiang" and not lexicon_pack_version():
            print("还没装万象词库，先运行 wowtype-config --install-lexicon wanxiang")
            return 1
        values["Lexicon"] = WANXIANG_LEXICON if args[1] == "wanxiang" else ""
    else:
        source = args[1] if len(args) > 1 else "wanxiang"
        if source == "wanxiang":
            release = fetch_latest()
            asset = find_lexicon_asset(release)
            if not asset:
                print(f"最新版 {release['version']} 的发布页上还没有万象词库包")
                return 1
            name, url, version = asset

            def progress(done, total):
                text = f"{human_size(done)} / {human_size(total)}" if total else human_size(done)
                print(f"\r下载 {name}：{text}   ", end="", flush=True)
            path = download_updates(release, [(name, url)], progress)[0]
            print()
        else:
            path = source
        version = install_lexicon_pack(path)
        if source == "wanxiang":
            os.unlink(path)
        print(f"万象词库 {version} 装好了：{WANXIANG_DIR}")
        values["Lexicon"] = WANXIANG_LEXICON
    write_config(values, extra)
    log(f"词库改为 {active_lexicon(values)[0]}（命令行）")
    running = fcitx_call_sync("ReloadAddonConfig", GLib.Variant("(s)", ("wowtype",))) is not None
    print("已切到" + ("万象拼音" if values["Lexicon"] else "雾凇拼音（默认）") +
          ("，fcitx5 正在后台换词库，过几秒生效" if running else "，fcitx5 下次启动时生效"))
    return 0


def lexicon_self_test():
    """词库包：找发布里的包、解包检查、装上、切换、删掉（不联网）。"""
    import io
    import tarfile
    import tempfile
    release = {"assets": {"wowtype-data-rime-ice-2026.10.31.2.tar.gz": "u0",
                          "wowtype-data-wanxiang-2026.11.10.0.tar.gz": "u1",
                          "wowtype-data-wanxiang-2026.11.9.3.tar.gz": "u2",
                          "wowtype_0.3.10_ubuntu24.04_amd64.deb": "u3"}}
    assert find_lexicon_asset(release) == ("wowtype-data-wanxiang-2026.11.10.0.tar.gz", "u1",
                                           "2026.11.10.0")
    assert find_lexicon_asset({"assets": {"wowtype-data-rime-ice-1.tar.gz": "x"}}) is None
    assert find_lexicon_asset(None) is None

    def make_pack(path, files):
        with tarfile.open(path, "w:gz") as tar:
            for name, text in files.items():
                data = text.encode("utf-8")
                info = tarfile.TarInfo(name)
                info.size = len(data)
                tar.addfile(info, io.BytesIO(data))
    lexicon = "# 测试\n" + "".join(f"ce shi\t测试{i}\t{i}\n" for i in range(LEXICON_PACK_MIN))
    good = {"lexicon.tsv": lexicon, "LICENSE": "CC BY 4.0", "SOURCE.txt": "src",
            "VERSION": "2026.11.10.0\n"}
    with tempfile.TemporaryDirectory() as tmp:
        folder = os.path.join(tmp, "dicts", "wanxiang")
        pack = os.path.join(tmp, "pack.tar.gz")
        make_pack(pack, good)
        assert lexicon_pack_version(folder) is None
        assert install_lexicon_pack(pack, folder) == "2026.11.10.0"
        assert sorted(os.listdir(folder)) == sorted(LEXICON_PACK_FILES)
        # 再装一遍（更新）：旧的快照跟着旧目录一起没了
        with open(os.path.join(folder, "lexicon.tsv.wcache"), "w") as f:
            f.write("old")
        make_pack(pack, {**good, "VERSION": "2026.11.11.0"})
        assert install_lexicon_pack(pack, folder) == "2026.11.11.0"
        assert not os.path.exists(os.path.join(folder, "lexicon.tsv.wcache"))
        # 坏包不装，原来的留着
        for bad in ({**good, "../evil": "x"}, {**good, "bin/sh": "x"},
                    {"LICENSE": "x", "VERSION": "1"},
                    {**good, "lexicon.tsv": "ni hao\t你好\t1\n"},
                    {**good, "lexicon.tsv": "nonsense\n" * LEXICON_PACK_MIN}):
            make_pack(pack, bad)
            try:
                install_lexicon_pack(pack, folder)
                raise AssertionError(f"坏包应该装不上：{sorted(bad)}")
            except ValueError:
                pass
            assert lexicon_pack_version(folder) == "2026.11.11.0"
            assert not os.path.exists(folder + ".new")
        with tarfile.open(pack, "w:gz") as tar:  # 符号链接也不行
            info = tarfile.TarInfo("lexicon.tsv")
            info.type = tarfile.SYMTYPE
            info.linkname = "/etc/passwd"
            tar.addfile(info)
        try:
            install_lexicon_pack(pack, folder)
            raise AssertionError("链接应该装不上")
        except ValueError:
            pass
        assert remove_lexicon_pack(folder) > 0 and not os.path.exists(folder)

        # 从发布页下载：本机起一个假的 Release，按 SHA256SUMS 校验后装上
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
        name = "wowtype-data-wanxiang-2026.11.12.0.tar.gz"
        make_pack(pack, {**good, "VERSION": "2026.11.12.0"})
        with open(pack, "rb") as f:
            files = {name: f.read()}
        files["SHA256SUMS"] = f"{hashlib.sha256(files[name]).hexdigest()}  {name}\n".encode()

        class Release(BaseHTTPRequestHandler):
            def do_GET(self):
                data = files.get(self.path.lstrip("/"))
                self.send_response(200 if data is not None else 404)
                self.send_header("Content-Length", str(len(data or b"")))
                self.end_headers()
                self.wfile.write(data or b"")

            def log_message(self, *_args):
                pass
        server = ThreadingHTTPServer(("127.0.0.1", 0), Release)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}"
        release = {"tag": "v9.9.9", "assets": {n: f"{base}/{n}" for n in files}}
        global UPDATE_DIR
        saved_dir, UPDATE_DIR = UPDATE_DIR, os.path.join(tmp, "updates")
        try:
            asset_name, url, _version = find_lexicon_asset(release)
            path = download_updates(release, [(asset_name, url)], lambda *_a: None)[0]
            assert install_lexicon_pack(path, folder) == "2026.11.12.0"
            files["SHA256SUMS"] = f"{'0' * 64}  {name}\n".encode()  # 校验和对不上：不装
            try:
                download_updates(release, [(asset_name, url)], lambda *_a: None)
                raise AssertionError("校验和不对应该失败")
            except RuntimeError:
                pass
        finally:
            UPDATE_DIR = saved_dir
            server.shutdown()
    assert active_lexicon({"Lexicon": ""}) == ("rime-ice", "")
    assert active_lexicon({"Lexicon": "/nonexistent/lexicon.tsv"}) == ("rime-ice", "")
    print("lexicon self-test ok")


