    def refresh_voice_model(self, progress=None):
        """模型在不在决定语音输入能不能打开：没有模型时开关灰掉、显示成关着（不改配置）。"""
        if not hasattr(self, "model_row"):
            return
        ready = voice_model_ready()
        busy = self.voice_cancel is not None
        if progress:
            subtitle = progress
        elif busy:
            subtitle = None  # 进度由下载线程更新
        elif ready:
            subtitle = f"已下载（{human_size(dir_size(VOICE_MODEL_DIR))}）：{_home(VOICE_MODEL_DIR)}"
        elif self.voice_error:
            subtitle = f"没下载好：{self.voice_error}。点「重试」再下"
        elif os.path.exists(VOICE_MODEL_DIR + ".apk.part"):
            done = os.path.getsize(VOICE_MODEL_DIR + ".apk.part")
            subtitle = (f"下了 {human_size(done)} / {human_size(VOICE_MODEL_SIZE)}，"
                        "点「下载」接着下")
        else:
            subtitle = (f"还没下载。要下载 {human_size(VOICE_MODEL_SIZE)}，"
                        f"解开后占 {human_size(VOICE_MODEL_DISK)} 左右")
        if subtitle is not None:
            self.model_row.set_subtitle(GLib.markup_escape_text(subtitle))
        self.voice_download.set_label("取消" if busy else ("重试" if self.voice_error else "下载"))
        self.voice_download.set_visible(busy or not ready)
        self.voice_download.set_sensitive(progress != "正在解包…")
        self.voice_delete.set_visible(ready and not busy)
        # 开关：有模型才能开；显示的样子跟着模型走，但不在这里写配置
        self.quiet_switch = True
        self.voice_row.set_active(ready and self.values["Voice"] == "True")
        self.quiet_switch = False
        self.voice_row.set_sensitive(ready)
        self.voice_row.set_subtitle(
            "按语音键说话，在本机识别，不联网" if ready else "要先在下面下载语音模型才能打开")

    def on_voice_download(self, _button):
        if self.voice_cancel is not None:
            self.voice_cancel.set()
            return
        cancel = threading.Event()
        self.voice_cancel = cancel
        self.voice_error = None
        self.refresh_voice_model("正在连接…")
        log(f"开始下载语音模型到 {_home(VOICE_MODEL_DIR)}")

        def progress(done, total):
            text = (f"正在下载：{human_size(done)} / {human_size(total)}（{done * 100 // total}%）"
                    if total else f"正在下载：{human_size(done)}")
            if done and done == total:
                text = "正在解包…"
            GLib.idle_add(self.refresh_voice_model, text)

        def work():
            error = None
            try:
                install_voice_model(progress=progress, cancelled=cancel.is_set)
            except DownloadCancelled:
                error = ""
            except ValueError as e:
                error = str(e)
            except OSError as e:
                reason = getattr(e, "reason", None) or e
                error = f"连不上下载服务器（{getattr(reason, 'strerror', None) or reason}）"
            except Exception as e:  # noqa: BLE001  网络错误各式各样
                error = str(e)
            GLib.idle_add(self.voice_download_done, error)
        threading.Thread(target=work, daemon=True).start()

    def voice_download_done(self, error):
        self.voice_cancel = None
        if error == "":
            log("语音模型下载暂停了")
            self.toast("已取消，再点下载会接着下")
        elif error:
            log(f"语音模型没下载好：{error}")
            self.voice_error = error
            self.toast(f"语音模型没下载好：{error}")
        else:
            # 用户自己点的下载：下完直接打开语音输入
            log("语音模型下载好了，打开语音输入")
            self.values["Voice"] = "True"
            self.save_config()
            self.toast("语音模型下载好了，语音输入已打开")
        self.refresh_voice_model()
        return GLib.SOURCE_REMOVE

