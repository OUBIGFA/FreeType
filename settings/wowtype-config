class DownloadCancelled(Exception):
    pass


def _digest_of(path, algo="sha256"):
    digest = hashlib.new(algo)
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            digest.update(chunk)
    return digest


def download_model(dest, url=None, sha256=None, progress=None, cancelled=None, timeout=30,
                   algo="sha256"):
    """下载到 dest（先写 dest.part，断了能接着下），校验 SHA256（algo="md5" 时 sha256 给 MD5）后改名。

    progress(已下载, 总大小) 时不时调一下；cancelled() 返回 True 时停下（.part 留着下次续）。
    校验不过就删掉 .part 抛 ValueError；网络出错抛 OSError。"""
    url = url or LOCAL_MODEL_URL
    sha256 = (sha256 or LOCAL_MODEL_SHA256).lower()
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    request = urllib.request.Request(url, headers={"User-Agent": f"WowType/{current_version()}"})
    if have:
        request.add_header("Range", f"bytes={have}-")
    try:
        response = urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as e:
        if e.code != 416 or not have:
            raise
        response = None  # .part 已经下完整了，只差校验
    done = have
    if response is None:
        digest = _digest_of(part, algo)
    else:
        with response:
            if have and response.status != 206:
                have = done = 0  # 服务不支持续传：从头来
            length = int(response.headers.get("Content-Length") or 0)
            total = have + length if length else 0
            digest = _digest_of(part, algo) if have else hashlib.new(algo)
            last = 0.0
            with open(part, "ab" if have else "wb") as out:
                while chunk := response.read(1 << 16):
                    if cancelled and cancelled():
                        raise DownloadCancelled()
                    out.write(chunk)
                    digest.update(chunk)
                    done += len(chunk)
                    now = time.monotonic()
                    if progress and now - last > 0.2:
                        last = now
                        progress(done, total)
    if digest.hexdigest() != sha256:
        os.unlink(part)
        raise ValueError(f"下载的文件校验不对（{algo.upper()} 不一致），已删除，请重试")
    os.replace(part, dest)
    if progress:
        progress(done, done)
    return dest


