def llama_asset(machine=None, nixos=None):
    """这台机器能用的官方包：（下载地址, 大小, sha256）。没有合适的返回 None。

    NixOS 跑不了官方二进制（没有 /lib64/ld-linux），要在系统配置里装 llama-cpp。"""
    machine = os.uname().machine if machine is None else machine
    nixos = os.path.exists("/etc/NIXOS") if nixos is None else nixos
    if nixos or machine not in LLAMA_ASSETS:
        return None
    name, size, sha256 = LLAMA_ASSETS[machine]
    url = os.environ.get("WOWTYPE_LLAMA_URL") or (
        f"{LLAMA_PAGE}/releases/download/{LLAMA_BUILD}/llama-{LLAMA_BUILD}-bin-{name}.tar.gz")
    return url, size, os.environ.get("WOWTYPE_LLAMA_SHA256") or sha256


