def download_self_test():
    """用本机临时 HTTP 服务测 download_model：整个下、续传、校验失败、取消。"""
    import http.server
    import tempfile
    blob = os.urandom(300_000)
    good = hashlib.sha256(blob).hexdigest()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def do_GET(self):
            start = 0
            if rng := self.headers.get("Range"):
                start = int(rng.split("=")[1].split("-")[0])
                if start >= len(blob):
                    self.send_response(416)
                    self.end_headers()
                    return
                self.send_response(206)
            else:
                self.send_response(200)
            self.send_header("Content-Length", str(len(blob) - start))
            self.end_headers()
            self.wfile.write(blob[start:])

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{server.server_address[1]}/m.gguf"
    with tempfile.TemporaryDirectory() as tmp:
        dest = os.path.join(tmp, "models", "m.gguf")
        assert download_model(dest, url, good) == dest
        assert open(dest, "rb").read() == blob and not os.path.exists(dest + ".part")
        os.unlink(dest)
        with open(dest + ".part", "wb") as f:  # 续传
            f.write(blob[:123_456])
        download_model(dest, url, good)
        assert open(dest, "rb").read() == blob
        os.unlink(dest)
        with open(dest + ".part", "wb") as f:  # .part 已完整：服务回 416
            f.write(blob)
        download_model(dest, url, good)
        assert open(dest, "rb").read() == blob
        os.unlink(dest)
        try:
            download_model(dest, url, "0" * 64)
            raise AssertionError("校验不对应该报错")
        except ValueError:
            assert not os.path.exists(dest) and not os.path.exists(dest + ".part")
        try:
            download_model(dest, url, good, cancelled=lambda: True)
            raise AssertionError("取消应该报 DownloadCancelled")
        except DownloadCancelled:
            assert not os.path.exists(dest) and os.path.exists(dest + ".part")
        assert local_model_path({"TranslateLocalModel": ""}).endswith(LOCAL_MODEL_FILE)
        assert local_model_path({"TranslateLocalModel": "~/x.gguf"}) == os.path.expanduser("~/x.gguf")
    server.shutdown()


