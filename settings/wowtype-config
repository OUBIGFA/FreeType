    def filter_model_row(self, row):
        query = self.model_search.get_text().strip().lower()
        return not query or query in row.model_id.lower()

    def load_models(self):
        base = self.url_row.get_text().strip()
        key = self.key_entry.get_text().strip()
        self.model_search.set_text("")
        if not base:
            self.fill_models(None, "先填接口地址")
            return
        if self.models is not None and self.models_for == (base, key):
            self.fill_models(self.models, None)
            return
        self.fill_models([], "正在获取模型列表…")
        token = (base, key)
        self.models_for = token

        def work():
            try:
                result = (fetch_models(base, key), None)
            except TranslateError as e:
                result = (None, str(e))
            GLib.idle_add(self.models_loaded, token, *result)
        threading.Thread(target=work, daemon=True).start()

    def models_loaded(self, token, models, error):
        if token != self.models_for:
            return
        self.models = models
        if models is None:
            self.models_for = None
            self.fill_models(None, f"获取失败：{error}。也可以直接在框里打模型名。")
        elif not models:
            self.fill_models([], "服务没有列出模型，直接在框里打模型名")
        else:
            self.fill_models(models, None)

    def fill_models(self, models, status):
        self.model_list.remove_all()
        self.model_status.set_label(status or "")
        self.model_status.set_visible(bool(status))
        for model in models or []:
            label = Gtk.Label(label=model, xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            row = Gtk.ListBoxRow(child=label)
            row.model_id = model
            self.model_list.append(row)

    def on_model_picked(self, _list, row):
        self.tmodel_row.set_text(row.model_id)
        self.model_button.popdown()

    def on_provider_selected(self, row, _param):
        if self.provider_syncing:
            return
        _name, url, model = TRANSLATE_PROVIDERS[row.get_selected()]
        if not url:  # 「其他」：留着现在的地址让用户改
            self.url_row.grab_focus()
            return
        previous = self.tmodel_row.get_text().strip()
        suggested = {m for _, _, m in TRANSLATE_PROVIDERS if m}
        # 换地址时输入框先清空再填（中间会发一次空地址的 changed），这时不能回头改下拉框：
        # 下拉框还在处理这次点击，选中项被改成「其他」再改回来，GTK 会在里面死循环
        self.provider_syncing = True
        try:
            self.url_row.set_text(url)
        finally:
            self.provider_syncing = False
        # 模型框空着（或者还是别家建议的模型）时换成这家建议的
        if not previous or previous in suggested:
            self.tmodel_row.set_text(model)

    def on_url_changed(self, row):
        text = row.get_text().strip()
        self.set_value("TranslateBaseUrl", text)
        # 自己改地址时下拉框跟着变；地址是下拉框填进来的就不用管
        index = provider_index(text)
        if not self.provider_syncing and self.provider_row.get_selected() != index:
            self.provider_syncing = True
            try:
                self.provider_row.set_selected(index)
            finally:
                self.provider_syncing = False
        self.refresh_translate_status()

    def on_key_changed(self, _row):
        if self.key_source:
            GLib.source_remove(self.key_source)
        self.key_source = GLib.timeout_add(400, self.save_translate_key)

    def save_translate_key(self):
        self.key_source = 0
        try:
            write_translate_key(self.key_entry.get_text())
        except OSError as e:
            self.toast(f"Key 保存失败：{e.strerror}")
