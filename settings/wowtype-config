    def refresh_shift_conflict(self):
        """看 fcitx5 有没有用 WowType 要的 Shift 切输入法，更新「输入」「翻译」两页的提示。"""
        toggle = self.values.get("ShiftToggle", "Both")

        def done(config):
            hotkey = None if config is None else config.get("Hotkey")
            self.fcitx_hotkey = hotkey if isinstance(hotkey, dict) else None
            conflicts = [] if self.fcitx_hotkey is None else shift_conflicts(self.fcitx_hotkey, toggle)
            freed = [tuple(x) for x in read_state().get("fcitx_shift_freed", [])]
            self.shift_conflicts = conflicts
            row = self.shift_free_row
            row.set_visible(self.fcitx_hotkey is not None and toggle != "Off"
                            and bool(conflicts or freed))
            row.handler_block(self.shift_free_handler)
            row.set_active(not conflicts)
            row.handler_unblock(self.shift_free_handler)
            # 这次让出来了，但 fcitx5 没存进配置文件（下次启动又会拿走）
            unsaved = (freed and not conflicts and self.fcitx_hotkey is not None
                       and shift_conflicts(saved_fcitx_hotkey()[0], toggle))
            if conflicts:
                option = FCITX_OPTION_NAMES[conflicts[0][0]]
                side = shift_side_names(conflicts)
                row.set_subtitle(
                    f"{side} 现在被 fcitx5 用来「{option}」（比如切到 en 键盘），WowType 收不到，"
                    f"单按{side} 切不到英文和「译」。打开就让给 WowType")
                row.add_css_class("wt-warning")
            elif unsaved:
                row.set_subtitle(f"只在这次有效：{fcitx_config_hint()}")
                row.add_css_class("wt-warning")
            else:
                trigger = key_list(self.fcitx_hotkey.get("TriggerKeys")) if self.fcitx_hotkey else []
                switch_hint = (f"切到别的输入法按 {key_label(trigger[0])}" if trigger
                               else "切到别的输入法要在 fcitx5 配置里设快捷键")
                row.set_subtitle(f"fcitx5 不再用 Shift 切输入法；{switch_hint}。关掉就还给 fcitx5")
                row.remove_css_class("wt-warning")
            self.refresh_translate_status()
        self.fcitx.get_config(GLOBAL_URI, done)

    def on_shift_free_toggled(self, row, _param):
        hotkey = self.fcitx_hotkey
        if hotkey is None:
            self.refresh_shift_conflict()
            return
        freed = [tuple(x) for x in read_state().get("fcitx_shift_freed", [])]
        if row.get_active():
            lists, taken = without_shift(hotkey, self.values.get("ShiftToggle", "Both"))
            if not taken:
                self.refresh_shift_conflict()
                return
            keep = freed + [k for k in taken if k not in freed]

            def done(ok):
                if ok:
                    update_state(fcitx_shift_freed=[list(k) for k in keep])
                    log(f"把 fcitx5 的 {', '.join(f'{o}={k}' for o, k in taken)} 让给 WowType")
                    saved, path = saved_fcitx_hotkey()
                    if shift_conflicts(saved, self.values.get("ShiftToggle", "Both")):
                        # SetConfig 存文件失败也不报错，只改了 fcitx5 内存里的（dbusmodule.cpp）
                        log(f"fcitx5 没存进配置文件，下次启动读的是 {path or '默认值'}")
                        self.toast("只在这次有效：fcitx5 存不了配置文件")
                    else:
                        self.toast(f"{shift_side_names(taken)} 已经让给 WowType")
                else:
                    self.toast("没改成：fcitx5 没响应")
                self.refresh_shift_conflict()
        else:
            # 还回去：还的是当初让出来的；没有记录（比如手动改过）就还 fcitx5 默认的左 Shift
            back = freed or [("AltTriggerKeys", "Shift_L")]
            lists = with_keys(hotkey, back)

            def done(ok):
                if ok:
                    update_state(fcitx_shift_freed=[])
                    log(f"把 {', '.join(f'{o}={k}' for o, k in back)} 还给 fcitx5")
                    self.toast(f"已还给 fcitx5：{shift_side_names(back)} 又用来切换输入法")
                else:
                    self.toast("没改成：fcitx5 没响应")
                self.refresh_shift_conflict()
        self.fcitx.set_hotkeys(lists, done)

