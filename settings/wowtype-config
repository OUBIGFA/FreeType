    def start_local_download(self):
        """把还差的都下了：模型，和系统里没有时的 llama-server。进度都显示在「翻译模型」那一行。"""
        dest = os.path.join(MODELS_DIR, LOCAL_MODEL_FILE)
        want_model, want_llama, _size = self.local_missing()
        if self.local_cancel is not None or not (want_model or want_llama):
            return
        cancel = threading.Event()
        self.local_cancel = cancel
        self.local_model_row.set_subtitle("正在连接…")
        self.refresh_local_translate()
        log("开始下载：" + "、".join(
            name for name, want in (("本地翻译模型", want_model), ("llama-server", want_llama)) if want))

        def progress_of(what):
            def progress(done, total):
                text = (f"正在下载{what}：{human_size(done)} / {human_size(total)}（{done * 100 // total}%）"
                        if total else f"正在下载{what}：{human_size(done)}")
                GLib.idle_add(self.local_model_row.set_subtitle, text)
            return progress

        def work():
            error = None
            try:
                if want_model:
                    download_model(dest, progress=progress_of("模型"), cancelled=cancel.is_set)
                if want_llama:
                    install_llama_server(progress=progress_of("运行程序"), cancelled=cancel.is_set)
            except DownloadCancelled:
                error = "已暂停，再点下载会接着下"
            except ValueError as e:
                error = str(e)
            except OSError as e:
                error = f"下载失败：{getattr(e, 'reason', None) or e}"
            GLib.idle_add(self.local_download_done, error)
        threading.Thread(target=work, daemon=True).start()

    def local_download_done(self, error):
        self.local_cancel = None
        if error:
            log(f"本地翻译没下完：{error}")
            self.toast(error)
        else:
            log("本地翻译下载完成，校验通过")
            self.toast("下载好了，可以用离线翻译了" if self.local_ready() else "模型下载好了")
        self.fcitx.reload()
        self.refresh_local_translate()

    def on_local_delete(self, _button):
        """删掉下载的模型和 WowType 自己下载的 llama-server（系统里装的不动）。"""
        path = local_model_path(self.values)
        freed = os.path.getsize(path) if os.path.isfile(path) else 0
        try:
            if freed:
                os.unlink(path)
        except OSError as e:
            self.toast(f"删不掉：{e.strerror}")
        else:
            remove_llama_server()
            self.toast(f"已删除，空出 {human_size(freed)}" if freed else "已删除")
            self.fcitx.reload()
        self.refresh_local_translate()

