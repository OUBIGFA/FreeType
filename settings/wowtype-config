        self.lexicon_updating = True
        self.wanxiang_check.set_active(kind == "wanxiang")
        self.rime_check.set_active(kind == "rime-ice")
        self.lexicon_updating = False
        asset = find_lexicon_asset(self.release) if getattr(self, "release", None) else None
        newer = bool(asset and version and parse_version(asset[2]) > parse_version(version))
        if progress:
            subtitle = progress
        elif kind == "custom":
            subtitle = f"现在用的是 wowtype.conf 里指定的词库：{_home(path)}"
        elif version:
            subtitle = (f"已装 {version}（{human_size(os.path.getsize(WANXIANG_LEXICON))}），约 170 万条"
                        + (f"；有新版 {asset[2]}" if newer else ""))
        elif getattr(self, "release", None) and not asset:
            subtitle = "最新的发布页上还没有万象词库包，可以先从文件安装"
        else:
            subtitle = "约 170 万条，要下载约 20 MB"
        self.wanxiang_row.set_subtitle(GLib.markup_escape_text(subtitle))
        self.lexicon_button.set_label("更新" if version else "下载")
        self.lexicon_button.set_visible(not self.lexicon_busy and (not version or newer)
                                        and not (getattr(self, "release", None) and not asset))
        self.lexicon_file.set_sensitive(not self.lexicon_busy)
        self.lexicon_delete.set_visible(bool(version) and kind != "wanxiang" and not self.lexicon_busy)
        self.wanxiang_check.set_sensitive(not self.lexicon_busy)

    def on_lexicon_choice(self, button):
        if self.lexicon_updating or not button.get_active():
            return
        if button is self.wanxiang_check and not lexicon_pack_version():
            # 还没下载：先下载，装好了再切过去
            self.refresh_lexicon()
            self.start_lexicon_install()
            return
        self.use_lexicon(WANXIANG_LEXICON if button is self.wanxiang_check else "")

    def use_lexicon(self, path):
        self.values["Lexicon"] = path
        self.save_config()  # 每次都让插件重读：词库包更新了、路径没变也要重载
        log(f"词库改为 {active_lexicon(self.values)[0]}")
        self.toast(("已切到万象拼音" if path else "已切回雾凇拼音") + "，几秒后生效")
        self.refresh_lexicon()

    def start_lexicon_install(self, tarball=None):
        """下载（或者从 tarball 文件）装万象词库，装好后切过去。"""
        if self.lexicon_busy:
            return
        self.lexicon_busy = True
        self.refresh_lexicon("正在连接…" if tarball is None else "正在安装…")
        release = getattr(self, "release", None)

        def progress(done, total):
            text = (f"正在下载：{human_size(done)} / {human_size(total)}（{done * 100 // total}%）"
                    if total else f"正在下载：{human_size(done)}")
            GLib.idle_add(self.refresh_lexicon, text)

        def work():
            error = version = None
            try:
                if tarball is None:
                    latest = release or fetch_latest()
                    asset = find_lexicon_asset(latest)
                    if not asset:
                        raise RuntimeError(f"{latest['version']} 的发布页上还没有万象词库包")
                    name, url, _version = asset
                    path = download_updates(latest, [(name, url)], progress)[0]
                    GLib.idle_add(self.refresh_lexicon, "正在安装…")
                    try:
                        version = install_lexicon_pack(path)
                    finally:
                        os.unlink(path)
                else:
                    version = install_lexicon_pack(tarball)
            except (OSError, ValueError, RuntimeError) as e:
                error = str(getattr(e, "reason", None) or e)
            except Exception as e:  # noqa: BLE001  网络错误各式各样
                error = str(e)
            GLib.idle_add(self.lexicon_install_done, error, version)
        threading.Thread(target=work, daemon=True).start()

    def lexicon_install_done(self, error, version):
        self.lexicon_busy = False
        if error:
            log(f"万象词库没装好：{error}")
            self.toast(f"万象词库没装好：{error}")
            self.refresh_lexicon()
            return GLib.SOURCE_REMOVE
        log(f"万象词库 {version} 装好了")
        self.use_lexicon(WANXIANG_LEXICON)
        return GLib.SOURCE_REMOVE

