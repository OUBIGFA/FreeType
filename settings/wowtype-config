def llama_self_test():
    """unpack_llama / install_llama_server：只留 llama-server 和动态库、不往外写、跑不起来就不装。"""
    import io
    import tarfile
    import tempfile

    def pack(path, files, links=()):
        with tarfile.open(path, "w:gz") as tar:
            for name, body in files:
                info = tarfile.TarInfo(name)
                info.size = len(body)
                info.mode = 0o755
                tar.addfile(info, io.BytesIO(body))
            for name, to in links:
                info = tarfile.TarInfo(name)
                info.type = tarfile.SYMTYPE
                info.linkname = to
                tar.addfile(info)

    ok = b"#!/bin/sh\necho version: test\n"
    with tempfile.TemporaryDirectory() as tmp:
        root = os.path.join(tmp, "llama")
        archive = os.path.join(tmp, "a.tar.gz")
        pack(archive, [("llama-x/llama-server", ok), ("llama-x/libllama.so.0.9", b"lib"),
                       ("llama-x/llama-cli", ok), ("llama-x/../../evil", b"x"),
                       ("llama-x/sub/libdeep.so", b"x")],
             [("llama-x/libllama.so", "libllama.so.0.9")])
        server = unpack_llama(archive, root)
        assert server == downloaded_llama_server(root)
        assert sorted(os.listdir(root)) == ["VERSION", "libllama.so", "libllama.so.0.9", "llama-server"]
        assert os.readlink(os.path.join(root, "libllama.so")) == "libllama.so.0.9"
        assert not os.path.exists(os.path.join(tmp, "evil")) and not os.path.exists(root + ".new")
        assert find_llama_server("", downloaded=server) in (shutil.which("llama-server"), server)
        # 跑不起来的不装，原来那份留着
        pack(archive, [("llama-x/llama-server", b"#!/bin/sh\necho 'libgomp.so.1: not found' >&2\nexit 127\n")])
        try:
            unpack_llama(archive, root)
            raise AssertionError("跑不起来的 llama-server 不该装上")
        except ValueError as e:
            assert "libgomp" in str(e), e
        assert downloaded_llama_server(root) == server and not os.path.exists(root + ".new")
        for bad in ([("llama-x/readme", b"x")], None):
            if bad is None:
                with open(archive, "wb") as f:
                    f.write(b"not a tarball")
            else:
                pack(archive, bad)
            try:
                unpack_llama(archive, root)
                raise AssertionError("坏包不该装上")
            except ValueError:
                pass
        # 指到目录外面的链接
        pack(archive, [("llama-x/llama-server", ok)], [("llama-x/libx.so", "../../etc/passwd")])
        try:
            unpack_llama(archive, root)
            raise AssertionError("链接指到外面")
        except ValueError:
            pass
        # 整条路：下载、校验、解包；校验不对不装
        pack(archive, [("llama-x/llama-server", ok)])
        good = hashlib.sha256(open(archive, "rb").read()).hexdigest()
        url = "file://" + urllib.request.pathname2url(archive)
        fresh = os.path.join(tmp, "fresh")
        assert install_llama_server(root=fresh, asset=(url, 0, good)) == downloaded_llama_server(fresh)
        assert not os.path.exists(fresh + ".tar.gz")
        remove_llama_server(fresh)
        assert downloaded_llama_server(fresh) is None
        try:
            install_llama_server(root=fresh, asset=(url, 0, "0" * 64))
            raise AssertionError("校验不对")
        except ValueError:
            pass
        assert downloaded_llama_server(fresh) is None
    assert llama_asset("x86_64", False)[0].endswith(f"llama-{LLAMA_BUILD}-bin-ubuntu-x64.tar.gz") \
        or os.environ.get("WOWTYPE_LLAMA_URL")
    assert llama_asset("x86_64", True) is None and llama_asset("riscv64", False) is None
    assert llama_asset("aarch64", False)[2] == (
        os.environ.get("WOWTYPE_LLAMA_SHA256") or LLAMA_ASSETS["aarch64"][2])


