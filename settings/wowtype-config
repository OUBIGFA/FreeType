CHECK_INTERVAL = 55 * 60


def current_version():
    return VERSION if not VERSION.startswith("@") else "0"


def parse_version(text):
    """`v0.2.1`、`0.2.1-1~ubuntu26.04`、`2026.10.31` -> 数字元组。"""
    text = text.strip().lstrip("vV").split("-")[0].split("~")[0]
    return tuple(int(n) for n in re.findall(r"\d+", text))


def dpkg_version(package):
    """已装 deb 包的版本；没装（或不是 Debian 系）返回 None。"""
    try:
        out = subprocess.run(["dpkg-query", "-W", "-f=${Status}\t${Version}", package],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    status, _, version = out.stdout.partition("\t")
    return version if out.returncode == 0 and status.endswith(" installed") else None


def read_os_release():
    """读取发行版标识，不执行 os-release 中的内容。"""
    info = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    key, sep, value = line.strip().partition("=")
                    if sep and re.fullmatch(r"[A-Z_][A-Z_0-9]*", key):
                        try:
                            words = shlex.split(value, comments=True)
                            if len(words) == 1:
                                info[key] = words[0]
                        except ValueError:
                            pass
            break
        except OSError:
            continue
    return info


def update_platform(info=None, machine=None, immutable=None):
    """返回（包管理器、发布包发行版、架构、手动更新说明）。"""
    info = read_os_release() if info is None else info
    machine = os.uname().machine if machine is None else machine
    immutable = os.path.exists("/run/ostree-booted") if immutable is None else immutable
    distro = info.get("ID", "").lower()
    version = info.get("VERSION_ID", "")
    family = set(info.get("ID_LIKE", "").lower().split()) | {distro}
    variant = info.get("VARIANT_ID", "").lower()
    guide = f"安装说明：{INSTALL_GUIDE}"
    if "nixos" in family:
        return "", "", "", "NixOS 请更新 flake 输入后运行 nixos-rebuild switch；" + guide
    if immutable or "atomic" in variant or variant in {
            "silverblue", "kinoite", "sericea", "onyx", "coreos"}:
        return "", "", "", "不可变系统请使用系统的分层或声明式配置更新（Fedora Atomic 用 rpm-ostree）；" + guide
    if "manjaro" in family:
        return "", "", "", "Manjaro 请用 scripts/package-arch.sh 在本机编包，避免混用 Arch 滚动库；" + guide
    # deb 和 rpm 对同一种架构叫法不同：amd64 / x86_64、arm64 / aarch64
    deb_arch, rpm_arch = {"x86_64": ("amd64", "x86_64"), "amd64": ("amd64", "x86_64"),
                          "aarch64": ("arm64", "aarch64"),
                          "arm64": ("arm64", "aarch64")}.get(machine, ("", ""))
    if not deb_arch:
        return "", "", "", f"发布包只有 x86_64 和 arm64，{machine} 请从源码构建；{guide}"
    if distro == "ubuntu" and version in ("24.04", "26.04"):
        return "apt-get", "ubuntu" + version, deb_arch, ""
    if distro == "debian" and (version == "13" or version.startswith("13.")):
        return "apt-get", "debian13", deb_arch, ""
    # 衍生发行版只有明确声明了兼容基底才套用对应 deb，绝不拿自己的版本号猜。
    if distro not in ("ubuntu", "debian"):
        codename = info.get("UBUNTU_CODENAME", "")
        if not codename and "ubuntu" in family:
            codename = info.get("VERSION_CODENAME", "")
        ubuntu = {"noble": "24.04", "resolute": "26.04"}.get(codename)
        if ubuntu:
            return "apt-get", "ubuntu" + ubuntu, deb_arch, ""
        codename = info.get("DEBIAN_CODENAME", "")
        if not codename and "debian" in family:
            codename = info.get("VERSION_CODENAME", "")
        if codename == "trixie":
            return "apt-get", "debian13", deb_arch, ""
    if family & {"arch", "archlinux", "endeavouros", "garuda", "cachyos"}:
        if rpm_arch != "x86_64":
            return "", "", "", (f"Arch Linux 的发布包只有 x86_64，{machine} 请用 "
                                f"scripts/package-arch.sh 在本机编包；{guide}")
        return "pacman", "archlinux", "x86_64", ""
    if distro == "fedora" and re.fullmatch(r"[0-9]+", version):
        return "dnf", "fc" + version, rpm_arch, ""
    return "", "", "", f"{distro or '这个发行版'} 请按发行版说明从源码更新；{guide}"


def package_version(manager, package=ENGINE_PKG):
    """查询对应包管理器，源码安装不会误走二进制更新。"""
    if manager == "apt-get":
        return dpkg_version(package)
    commands = {"pacman": ["pacman", "-Q", package],
                "dnf": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", package]}
    if manager not in commands:
        return None
    try:
        result = subprocess.run(commands[manager], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value.split(" ", 1)[-1] if value else None


def install_commands(manager, paths):
    """使用参数列表调用包管理器。Arch 只 -U，不替用户 -Syu（依赖不满足时 pacman 会报错）。"""
    if not paths or any(not os.path.isabs(path) for path in paths):
        raise ValueError("安装包必须是已校验的本地绝对路径")
    if manager == "apt-get":
        return [["pkexec", "apt-get", "install", "-y", *paths]]
    if manager == "dnf":
        return [["pkexec", "dnf", "install", "-y", *paths]]
    if manager == "pacman":
        return [["pkexec", "pacman", "-U", "--noconfirm", *paths]]
    raise ValueError("这个系统请按安装说明手动更新")


def http_open(url, timeout=30):
    request = urllib.request.Request(url, headers={
        "User-Agent": f"WowType-Updater/{current_version()}",
        "Accept": "application/vnd.github+json" if "api.github.com" in url else "*/*",
    })
    return urllib.request.urlopen(request, timeout=timeout)


_MD_INLINE = re.compile(r"\*\*(.+?)\*\*|`([^`]+)`|\[([^\]]+)\]\((https?://[^)\s]+)\)|(https?://[^\s<>()]+)")


def _md_inline(text):
    """一行 Markdown 里的粗体、代码、链接 → Pango 标记，其余文字转义。"""
    out, pos = [], 0
    for m in _MD_INLINE.finditer(text):
        out.append(GLib.markup_escape_text(text[pos:m.start()]))
        bold, code, label, href, bare = m.groups()
        if bold is not None:
            out.append(f"<b>{_md_inline(bold)}</b>")
        elif code is not None:
            out.append(f"<tt>{GLib.markup_escape_text(code)}</tt>")
        elif label is not None:
            out.append(f'<a href="{GLib.markup_escape_text(href)}">{GLib.markup_escape_text(label)}</a>')
        else:
            url = GLib.markup_escape_text(bare)
            out.append(f'<a href="{url}">{url}</a>')
        pos = m.end()
    out.append(GLib.markup_escape_text(text[pos:]))
    return "".join(out)


def release_highlights(notes):
    """发布说明里只留「## 这一版」那一节（去掉标题本身）；没有这一节就原样返回。

    后面的安装步骤、自动生成的提交列表对已经装好的人没用，放进「更新内容」只会很长。
    """
    lines = notes.strip().splitlines()
    for i, line in enumerate(lines):
        if re.match(r"^##\s*这一版\s*$", line.strip()):
            body = []
            for rest in lines[i + 1:]:
                if re.match(r"^#{1,2}\s", rest):
                    break
                body.append(rest)
            text = "\n".join(body).strip()
            return text or notes.strip()
    return notes.strip()


def markdown_to_pango(md):
    """GitHub Release 说明（Markdown）→ Gtk.Label 能显示的 Pango 标记。

    只认 Release 说明里会用到的：标题、列表（含缩进的子项）、代码块、粗体、行内代码、链接。
    """
    lines, in_code = [], False
    for raw in md.replace("\r\n", "\n").split("\n"):
        line = raw.rstrip()
        if line.lstrip().startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            lines.append("    <tt>" + GLib.markup_escape_text(line) + "</tt>")
            continue
        heading = re.match(r"(#{1,6})\s+(.*)", line)
        item = re.match(r"(\s*)[-*+]\s+(.*)", line)
        if heading:
            size = "large" if len(heading.group(1)) <= 2 else "medium"
            if lines and lines[-1] != "":
                lines.append("")
            lines.append(f'<span size="{size}" weight="bold">{_md_inline(heading.group(2))}</span>')
        elif item:
            depth = len(item.group(1).expandtabs(2)) // 2
            bullet = "•" if depth == 0 else "◦"
            lines.append("    " * depth + f"{bullet} {_md_inline(item.group(2))}")
        elif not line.strip():
            if lines and lines[-1] != "":
                lines.append("")
        else:
            lines.append(_md_inline(line.strip()))
    while lines and lines[-1] == "":
        lines.pop()
    # 整段标成简体中文：跟在英文后面的「。」也用简体字形
    return '<span lang="zh-cn">' + "\n".join(lines) + "</span>"


def fetch_latest():
    """GitHub 上最新的正式版：{tag, version, notes, url, assets: {文件名: 下载地址}}。"""
    with http_open(RELEASE_API, timeout=20) as response:
        data = json.load(response)
    return {
        "tag": data.get("tag_name", ""),
        "version": data.get("tag_name", "").lstrip("vV"),
        "notes": data.get("body") or "",
        "url": data.get("html_url") or RELEASES_PAGE,
        "assets": {a["name"]: a["browser_download_url"] for a in data.get("assets", [])},
    }


def is_newer(release):
    return parse_version(release["version"]) > parse_version(current_version())


def plan_update(release):
    """要下载的包：[(文件名, 地址)]，和一段说明。装不了时列表为空，说明里写原因。"""
    manager, distro, arch, reason = update_platform()
    if reason:
        return [], reason
    if package_version(manager) is None:
        return [], f"当前未通过 {manager} 安装 WowType，请按安装说明更新源码或系统配置"
    version = release["version"]
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~^-]*", version):
        return [], "发布版本号格式无效，请到下载页检查"
    if manager == "apt-get":
        name = f"wowtype_{version}_{distro}_{arch}.deb"
    elif manager == "pacman":
        name = f"wowtype-{version}-1-{arch}.pkg.tar.zst"
    else:
        name = f"wowtype-{version}-1.{distro}.{arch}.rpm"
    if name not in release["assets"]:
        return [], f"这一版没有 {distro} {arch} 的安装包，请按安装说明从源码构建，不混用其他发行版的包"
    if "SHA256SUMS" not in release["assets"]:
        return [], "发布页缺少 SHA256SUMS，暂不安装，请到下载页检查"
    reason = "要是提示依赖不满足，先在终端运行 sudo pacman -Syu 升级系统" if manager == "pacman" else ""
    return [(name, release["assets"][name])], reason


def download_updates(release, files, progress):
    """下载并按 SHA256SUMS 校验，返回本地路径列表。progress(已下字节, 总字节)。"""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+~^-]*", release["tag"]):
        raise RuntimeError("发布标签格式无效，不安装")
    folder = os.path.join(UPDATE_DIR, release["tag"])
    os.makedirs(folder, exist_ok=True)
    sums = {}
    wanted = {name for name, _url in files}
    if "SHA256SUMS" in release["assets"]:
        with http_open(release["assets"]["SHA256SUMS"]) as response:
            for line in response.read().decode("utf-8", "replace").splitlines():
                fields = line.strip().split(maxsplit=1)
                if len(fields) != 2:
                    continue
                digest, name = fields
                name = name.removeprefix("*")
                if name not in wanted:
                    continue
                if name in sums or not re.fullmatch(r"[0-9a-fA-F]{64}", digest):
                    raise RuntimeError(f"SHA256SUMS 中 {name} 的校验值重复或无效，不安装")
                sums[name] = digest.lower()
    paths = []
    for name, url in files:
        if os.path.basename(name) != name or name in (".", ".."):
            raise RuntimeError("发布包文件名无效，不安装")
        if name not in sums:
            raise RuntimeError(f"SHA256SUMS 里没有 {name}，不安装")
        path = os.path.join(folder, name)
        digest = hashlib.sha256()
        with http_open(url, timeout=60) as response, open(path + ".part", "wb") as out:
            total = int(response.headers.get("Content-Length") or 0)
            done = 0
            while chunk := response.read(1 << 16):
                out.write(chunk)
                digest.update(chunk)
                done += len(chunk)
                progress(done, total)
        if digest.hexdigest() != sums[name]:
            os.unlink(path + ".part")
            raise RuntimeError(f"{name} 校验和不对，可能没下完整，请重试")
        os.replace(path + ".part", path)
        paths.append(path)
    return paths


