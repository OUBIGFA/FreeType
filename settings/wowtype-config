# 解开后模型和词表大约多大（界面上提示用）
VOICE_MODEL_DISK = 130 * 1000 * 1000
# 语音包（.apk 其实是 zip）里套着的模型包，只要里面的 *.xnet 和词表
VOICE_MODEL_INNER = "ime_asr_decoder_model.zip"
VOICE_MODEL_DICT = "dict.decoder.utf8.txt"
VOICE_MODEL_NOTE = "语音模型是微信输入法的离线语音包，属于腾讯，从腾讯的服务器下载，WowType 不分发它。"


def voice_model_ready(folder=None):
    """语音模型在不在（和 voice/src/wtlocal/download.rs 的 is_ready 一样：有 .xnet 和词表）。"""
    folder = folder or VOICE_MODEL_DIR
    try:
        names = os.listdir(folder)
    except OSError:
        return False
    return VOICE_MODEL_DICT in names and any(n.endswith(".xnet") for n in names)


def unpack_voice_model(pack, folder):
    """从语音包里解出模型和词表到 folder：先解到旁边的临时目录，齐了再换进去。

    只取内层模型包里的 *.xnet 和词表，扁平解出（不认包里的路径），别的不要。
    坏包抛 ValueError，原来的 folder 不动。"""
    import io
    import zipfile
    staging = folder + ".new"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(staging)
    try:
        try:
            with zipfile.ZipFile(pack) as outer:
                inner_data = outer.read(VOICE_MODEL_INNER)
            with zipfile.ZipFile(io.BytesIO(inner_data)) as inner:
                for info in inner.infolist():
                    name = info.filename.replace("\\", "/").rsplit("/", 1)[-1]
                    if info.is_dir() or not (name.endswith(".xnet") or name == VOICE_MODEL_DICT):
                        continue
                    with inner.open(info) as src, open(os.path.join(staging, name), "wb") as out:
                        shutil.copyfileobj(src, out)
        except (zipfile.BadZipFile, KeyError) as e:
            raise ValueError(f"语音包格式不对：{e}") from e
        if not voice_model_ready(staging):
            raise ValueError("语音包里没有模型或词表，不安装")
        old = folder + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.exists(folder):
            os.replace(folder, old)
        os.replace(staging, folder)
        shutil.rmtree(old, ignore_errors=True)
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise


def install_voice_model(folder=None, pack=None, url=None, md5=None, size=None,
                        progress=None, cancelled=None):
    """下载语音包（断了能接着下）、核对大小和 MD5、解出模型。给了 pack 就用这个文件，不下载。

    下载的包放在 folder 旁边（wtlocal.apk），装好后删掉。取消抛 DownloadCancelled（.part 留着下次续），
    校验不过抛 ValueError（下载的坏包删掉），网络出错抛 OSError。返回模型占的字节数。"""
    folder = folder or VOICE_MODEL_DIR
    md5 = (md5 or VOICE_MODEL_MD5).lower()
    size = VOICE_MODEL_SIZE if size is None else size
    downloaded = pack is None
    if downloaded:
        pack = folder + ".apk"
        if not os.path.isfile(pack):
            download_model(pack, url or VOICE_MODEL_URL, md5, progress=progress,
                           cancelled=cancelled, algo="md5")
    try:
        have = os.path.getsize(pack)
        if have != size:
            raise ValueError(f"语音包大小不对：{have} 字节，应该是 {size} 字节")
        if _digest_of(pack, "md5").hexdigest() != md5:
            raise ValueError("语音包校验不对（MD5 不一致）")
        unpack_voice_model(pack, folder)
    finally:
        # 下载的包用完（或者是坏的）就删掉；用户给的文件留着
        if downloaded and os.path.exists(pack):
            os.unlink(pack)
    return dir_size(folder)


def remove_voice_model(folder=None):
    """删掉语音模型（连同没下完的包），返回空出的字节数。"""
    folder = folder or VOICE_MODEL_DIR
    size = 0
    for path in (folder, folder + ".apk", folder + ".apk.part", folder + ".part",
                 folder + ".tmp", folder + ".new", folder + ".old"):
        try:
            if os.path.isdir(path):
                size += dir_size(path)
                shutil.rmtree(path, ignore_errors=True)
            elif os.path.exists(path):
                size += os.path.getsize(path)
                os.unlink(path)
        except OSError:
            pass
    return size


