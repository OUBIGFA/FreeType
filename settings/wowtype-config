    def on_check_update(self, *_args):
        self.check_button.set_sensitive(False)
        self.latest_row.set_title("正在检查更新…")
        self.latest_row.set_subtitle("")

        def work():
            try:
                release = fetch_latest()
                files, reason = plan_update(release) if is_newer(release) else ([], "")
                result = (release, files, reason, None)
            except Exception as e:  # noqa: BLE001  网络错误各式各样
                result = (None, [], "", str(e))
            GLib.idle_add(self.show_check_result, *result)
        threading.Thread(target=work, daemon=True).start()

    def show_check_result(self, release, files, reason, error):
        self.check_button.set_sensitive(True)
        self.release = release
        self.update_files = files
        self.refresh_lexicon()
        if error:
            self.latest_row.set_title("检查更新失败")
            self.latest_row.set_subtitle(GLib.markup_escape_text(f"连不上 GitHub：{error}"))
            self.install_row.set_visible(False)
            return GLib.SOURCE_REMOVE
        state = read_update_state()
        state["checked"] = time.time()
        write_update_state(state)
        newer = is_newer(release)
        self.latest_row.set_title(
            f"有新版本 {release['version']}" if newer else "已经是最新版本")
        self.latest_row.set_subtitle(f"最新版本 {release['version']}")
        self.install_row.set_visible(newer)
        if newer:
            self.install_row.set_title("更新到 " + release["version"])
            self.install_row.set_subtitle(GLib.markup_escape_text(
                reason or "要下载：" + "、".join(name for name, _ in files)))
            self.install_button.set_visible(bool(files))
            self.page_button.set_label("打开下载页" if files else "打开安装说明")
            notes = release_highlights(release["notes"])
            self.notes_group.set_visible(bool(notes))
            try:
                self.notes_label.set_markup(markdown_to_pango(notes[:6000]))
            except GLib.Error:  # 标记拼坏了就退回纯文字
                self.notes_label.set_text(notes[:6000])
        else:
            self.notes_group.set_visible(False)
        return GLib.SOURCE_REMOVE

    def on_install_update(self, _button):
        if not self.release or not self.update_files:
            return
        release, files = self.release, list(self.update_files)
        self.install_button.set_sensitive(False)
        self.check_button.set_sensitive(False)
        self.progress.set_visible(True)
        self.progress.set_fraction(0)
        self.progress.set_show_text(True)
        self.progress.set_text("正在下载…")

        def progress(done, total):
            GLib.idle_add(lambda: (self.progress.set_fraction(done / total) if total
                                   else self.progress.pulse()) and False)

        def work():
            try:
                paths = download_updates(release, files, progress)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.install_failed, f"下载失败：{e}")
                return
            GLib.idle_add(self.run_installer, paths)
        threading.Thread(target=work, daemon=True).start()

    def run_installer(self, paths):
        self.progress.set_text("等待授权，正在安装…")
        self.progress.pulse()
        try:
            commands = install_commands(update_platform()[0], paths)
        except ValueError as e:
            self.install_failed(str(e))
            return GLib.SOURCE_REMOVE

        def launch(index):
            try:
                proc = Gio.Subprocess.new(
                    commands[index],
                    Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
            except GLib.Error as e:
                self.install_failed(f"启动安装失败：{e.message}")
                return

            def finished(proc, result):
                try:
                    _ok, out, _err = proc.communicate_utf8_finish(result)
                except GLib.Error as e:
                    self.install_failed(f"安装失败：{e.message}")
                    return
                if not proc.get_if_exited():
                    self.install_failed("安装进程中断，请查看包管理器状态后重试")
                    return
                code = proc.get_exit_status()
                if code == 0 and index + 1 < len(commands):
                    self.progress.set_text("系统已更新，正在安装 WowType…")
                    launch(index + 1)
                elif code == 0:
                    self.progress.set_visible(False)
                    self.install_row.set_visible(False)
                    self.restart_row.set_visible(True)
                    self.latest_row.set_title(f"已安装 {self.release['version']}")
                    self.updated = True
                    log(f"更新已安装：{self.release['version']}")
                    self.toast("更新已安装，重启输入法后生效")
                elif code in (126, 127):  # pkexec：取消授权 / 没通过
                    self.install_failed("没有授权，已取消")
                else:
                    tail = "\n".join((out or "").strip().splitlines()[-3:])
                    self.install_failed(f"安装失败：{tail or code}")
            proc.communicate_utf8_async(None, None, finished)

        launch(0)
        return GLib.SOURCE_REMOVE

    def install_failed(self, text):
        self.progress.set_visible(False)
        self.install_button.set_sensitive(True)
        self.check_button.set_sensitive(True)
        self.toast(text)
        return GLib.SOURCE_REMOVE

    def on_restart_fcitx(self, _button):
        def done(ok):
            if ok and getattr(self, "updated", False):
                # 刚装了新版：这个窗口还是旧程序，换成新装的设置界面（停在「更新」页）
                self.get_application().quit()
                os.execv(sys.executable, [sys.executable, os.path.abspath(__file__),
                                          "--page", "update"])
            self.toast("输入法已重启" if ok else "重启失败，可以注销后重新登录")
            if ok:
                self.restart_row.set_visible(False)
        self.fcitx.restart(done)

    # ---------------- 保存

    def set_value(self, key, value):
        if self.values.get(key) == value:
            return
        self.values[key] = value
        # 拖动数字框时不要每一下都写文件
        if self.save_source:
            GLib.source_remove(self.save_source)
        self.save_source = GLib.timeout_add(250, self.save_config)

    def save_config(self):
        self.save_source = 0
        try:
            write_config(self.values, self.extra)
        except OSError as e:
            self.toast(f"保存失败：{e.strerror}")
            return GLib.SOURCE_REMOVE
        self.fcitx.reload()
        return GLib.SOURCE_REMOVE

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=3))

